# Real local inference is the default portfolio path. Start Ollama before the app.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=
LLM_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=1800
LLM_SEED=42
LLM_MAX_RETRIES=2
# Use json_object for providers/models that do not support strict JSON Schema.
LLM_STRUCTURED_OUTPUT_MODE=json_schema

# Hybrid mode fuses local BGE embeddings with transparent lexical ranking.
# If the embedding service is unavailable, the session records an explicit lexical fallback.
RETRIEVAL_BACKEND=hybrid_ollama
EMBEDDING_MODEL=hf.co/CompendiumLabs/bge-base-en-v1.5-gguf:latest

STT_MODEL_SIZE=small
SPEECH_EMOTION_MODEL=
TEXT_EMOTION_MODEL=
MAX_INTERVIEW_QUESTIONS=5
MAX_DOCUMENT_BYTES=5242880
MAX_AUDIO_BYTES=26214400
MAX_AUDIO_SECONDS=300
DATA_RETENTION=false

# Local Uvicorn uses memory. Vercel should use upstash_redis so sessions and
# source documents survive requests handled by different function instances.
SESSION_BACKEND=memory
SESSION_TTL_SECONDS=86400
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LOG_LEVEL=INFO
