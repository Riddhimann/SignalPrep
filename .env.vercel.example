# Hosted inference profile. Add these in Vercel Project Settings, never in Git.
LLM_PROVIDER=openai_compatible
LLM_MODEL=qwen/qwen3.6-27b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=replace-with-groq-key
LLM_STRUCTURED_OUTPUT_MODE=json_object
LLM_REASONING_EFFORT=none
LLM_TIMEOUT_SECONDS=50
LLM_MAX_TOKENS=1400
LLM_SEED=42
LLM_MAX_RETRIES=1

# The measured local benchmark remains hybrid_ollama. The cloud demo uses the
# transparent TF-IDF retrieval path because Vercel cannot host Ollama/BGE.
RETRIEVAL_BACKEND=lexical_demo
EMBEDDING_MODEL=not-used-in-lexical-demo

# Durable state for stateless Vercel Functions. Documents expire after 24 h.
SESSION_BACKEND=upstash_redis
SESSION_TTL_SECONDS=86400
UPSTASH_REDIS_REST_URL=replace-with-upstash-rest-url
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

MAX_INTERVIEW_QUESTIONS=5
MAX_DOCUMENT_BYTES=4000000
MAX_AUDIO_BYTES=4000000
DATA_RETENTION=false
LOG_LEVEL=INFO
